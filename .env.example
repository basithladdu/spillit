# Copy this file to .env.local for local development.
# Vite exposes every VITE_* value to the browser bundle. Use public/client-safe
# values only; keep real server secrets out of this file and out of VITE_* names.

# Supabase Configuration (used by the memory feed and archive)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Firebase Configuration (used by authentication/storage helpers)
# Get credentials from Firebase Console (Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Mapbox Access Token
# Get your token from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Cloudinary Configuration
# Get credentials from https://cloudinary.com/
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# Video Processor Configuration
VITE_VIDEO_PROCESSOR_BASE_URL=https://api.spillit.app

# Comma-separated emails allowed to access /dashboard
VITE_ADMIN_EMAILS=you@example.com

# Roboflow API Key
# Required for pothole detection
# Get your key from https://roboflow.com/
# Keep this server-side; do not add it as a VITE_* variable.
